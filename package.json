{
  "name": "rack-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:assets && npm run build:physics && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "build:shadows": "node scripts/build-shadow-detail.mjs",
    "build:physics": "asc scripts/contact-kernel.ts --outFile src/contact-kernel.wasm -O3 --runtime stub --noAssert --initialMemory 1 --maximumMemory 128",
    "build:assets": "node scripts/build-compressed-assets.mjs",
    "build:models": "node scripts/build-web-models.mjs && npm run build:shadows && npm run build:assets"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "assemblyscript": "0.28.20",
    "vite": "^7.1.0"
  }
}
